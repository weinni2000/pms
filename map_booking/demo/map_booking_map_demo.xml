<odoo noupdate="1">
    <record id="map_booking_map_demo" model="map.booking.map">
        <field name="name">Camping Unterhub</field>
        <field
            name="image"
            type="base64"
            file="map_booking/static/src/img/map_demo.jpg"
        />
        <field name="image_filename">map_demo.jpg</field>
        <field name="show_legend" eval="True" />
        <field name="legend_position">bottom_left</field>
    </record>
    <!-- Floor plan of a holiday home: two flats and a dormitory whose beds are
         booked one by one. -->
    <record id="map_booking_map_demo_holiday_home" model="map.booking.map">
        <field name="name">Holiday Home</field>
        <field name="image" type="base64" file="map_booking/static/src/img/flat.png" />
        <field name="image_filename">flat.png</field>
        <field name="show_legend" eval="True" />
        <field name="legend_position">bottom_right</field>
    </record>
</odoo>
