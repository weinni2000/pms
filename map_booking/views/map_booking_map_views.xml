<odoo>
    <record id="map_booking_map_view_list" model="ir.ui.view">
        <field name="name">map.booking.map.list</field>
        <field name="model">map.booking.map</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="zone_ids" widget="many2many_tags" />
                <field name="active" invisible="1" />
            </list>
        </field>
    </record>

    <record id="map_booking_map_view_form" model="ir.ui.view">
        <field name="name">map.booking.map.form</field>
        <field name="model">map.booking.map</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="image" filename="image_filename" />
                            <field name="image_filename" invisible="1" />
                        </group>
                        <group>
                            <field name="show_legend" />
                            <field name="legend_position" invisible="not show_legend" />
                            <field name="label_scale" invisible="1" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="map_preview" string="Map Preview">
                            <field
                                name="preview_data_calculated"
                                widget="map_booking_map_preview"
                                nolabel="1"
                            />
                        </page>
                        <page name="availability" string="Availability">
                            <group>
                                <field
                                    name="availability_check_start"
                                    string="Stay (nights)"
                                    widget="daterange"
                                    options="{'end_date_field': 'availability_check_end'}"
                                />
                                <field name="refresh" />
                            </group>
                            <field
                                name="test_preview_data_calculated"
                                widget="map_booking_zone_map"
                                nolabel="1"
                            />
                        </page>
                        <page name="zones" string="Zones">
                            <field name="zone_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="points" />
                                    <button
                                        name="action_open_form"
                                        type="object"
                                        string="Open"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="map_booking_map_action" model="ir.actions.act_window">
        <field name="name">Maps</field>
        <field name="res_model">map.booking.map</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="map_booking_menu_root"
        name="Maps"
        groups="map_booking.group_map_booking_manager"
        sequence="40"
        web_icon="map_booking,static/description/icon.png"
    />

    <menuitem
        id="map_booking_map_menu"
        name="Maps"
        action="map_booking_map_action"
        parent="map_booking_menu_root"
        groups="map_booking.group_map_booking_manager"
        sequence="10"
    />
</odoo>
