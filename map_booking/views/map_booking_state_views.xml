<odoo>
    <record id="map_booking_state_view_list" model="ir.ui.view">
        <field name="name">map.booking.state.list</field>
        <field name="model">map.booking.state</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="color" />
                <field name="stroke_color" />
                <field name="hover_color" />
            </list>
        </field>
    </record>

    <record id="map_booking_state_action" model="ir.actions.act_window">
        <field name="name">Availability States</field>
        <field name="res_model">map.booking.state</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="map_booking_state_menu"
        name="Availability States"
        action="map_booking_state_action"
        parent="map_booking_menu_root"
        groups="map_booking.group_map_booking_manager"
        sequence="30"
    />
</odoo>
