<odoo noupdate="0">
    <!-- Module category for Settings app grouping -->
    <record model="ir.module.category" id="module_category_map_booking">
        <field name="name">Map Booking</field>
        <field name="sequence">95</field>
    </record>

    <!-- Privilege: groups the Map Booking groups under one entry -->
    <record model="res.groups.privilege" id="res_groups_privilege_map_booking">
        <field name="name">Map Booking</field>
        <field name="category_id" ref="module_category_map_booking" />
    </record>

    <!-- Group: Map Booking Manager -->
    <record id="group_map_booking_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_map_booking" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
</odoo>
