<odoo>
    <record id="map_booking_zone_view_list" model="ir.ui.view">
        <field name="name">map.booking.zone.list</field>
        <field name="model">map.booking.zone</field>
        <field name="inherit_id" ref="map_booking.map_booking_zone_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='map_id']" position="after">
                <field name="resource_ids" widget="many2many_tags" />
            </xpath>
        </field>
    </record>

    <record id="map_booking_zone_view_form" model="ir.ui.view">
        <field name="name">map.booking.zone.form</field>
        <field name="model">map.booking.zone</field>
        <field name="inherit_id" ref="map_booking.map_booking_zone_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="resources" string="Resources">
                    <field
                        name="resource_ids"
                        widget="many2many_tags"
                        context="{'active_test': False}"
                        options="{'no_create': True}"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
