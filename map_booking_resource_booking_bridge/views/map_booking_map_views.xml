<odoo>
    <record id="map_booking_map_view_form" model="ir.ui.view">
        <field name="name">map.booking.map.form</field>
        <field name="model">map.booking.map</field>
        <field name="inherit_id" ref="map_booking.map_booking_map_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='zones']/field[@name='zone_ids']"
                position="before"
            >
                <button
                    name="action_generate_zones_from_resources"
                    type="object"
                    string="Create Zone for Each Resource"
                    class="btn-secondary mb-2 me-1"
                />
            </xpath>
            <xpath
                expr="//field[@name='zone_ids']/list/field[@name='points']"
                position="after"
            >
                <field name="resource_ids" widget="many2many_tags" />
            </xpath>
        </field>
    </record>

    <!-- The maps belong to the Resource Bookings application. -->
    <record id="map_booking.map_booking_menu_root" model="ir.ui.menu">
        <field name="parent_id" ref="resource_booking.resource_booking_main_menu" />
    </record>
</odoo>
