            eval="[(0, 0, {
                'categ_id': ref('hotel_room_type_demo_dormitory_bed'),
                'reserve': [(6, 0, [ref('hotel_room_demo_dormitory_bed_1')])],
            })]"
        />
    </record>
    <!-- Dormitory bed 2 is taken today. -->
    <record id="hotel_reservation_demo_dormitory_bed_2" model="hotel.reservation">
        <field
            name="date_order"
            eval="(datetime.now() + timedelta(days=-1)).strftime('%Y-%m-%d 08:00:00')"
        />
