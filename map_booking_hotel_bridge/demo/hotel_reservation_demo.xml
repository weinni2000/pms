<odoo noupdate="1">
    <!-- Flat 1 is occupied today. -->
    <record id="hotel_reservation_demo_flat_1" model="hotel.reservation">
        <field
            name="date_order"
            eval="(datetime.now() + timedelta(days=-1)).strftime('%Y-%m-%d 08:00:00')"
        />
        <field
            name="checkin"
            eval="(datetime.now() + timedelta(days=-1)).strftime('%Y-%m-%d 15:00:00')"
        />
        <field
            name="checkout"
            eval="(datetime.now() + timedelta(days=3)).strftime('%Y-%m-%d 10:00:00')"
        />
        <field name="pricelist_id" ref="website_sale.list_europe" />
        <field name="partner_id" ref="base.res_partner_2" />
        <field name="partner_invoice_id" ref="base.res_partner_2" />
        <field name="partner_shipping_id" ref="base.res_partner_2" />
        <field name="adults">1</field>
        <field
            name="reservation_line"
            eval="[(0, 0, {
                'categ_id': ref('hotel_room_type_demo_holiday_home'),
                'reserve': [(6, 0, [ref('hotel_room_demo_flat_1')])],
            })]"
        />
    </record>
    <!-- Half of the dormitory beds are taken today, so the room stays free. -->
    <record id="hotel_reservation_demo_dormitory_bed_1" model="hotel.reservation">
        <field
            name="date_order"
            eval="(datetime.now() + timedelta(days=-1)).strftime('%Y-%m-%d 08:00:00')"
        />
        <field
            name="checkin"
