            eval="(datetime.now() + timedelta(days=2)).strftime('%Y-%m-%d 10:00:00')"
        />
        <field name="pricelist_id" ref="website_sale.list_europe" />
        <field name="partner_id" ref="base.res_partner_3" />
        <field name="partner_invoice_id" ref="base.res_partner_3" />
        <field name="partner_shipping_id" ref="base.res_partner_3" />
        <field name="adults">1</field>
        <field
            name="reservation_line"
            eval="[(0, 0, {
                'categ_id': ref('hotel_room_type_demo_dormitory_bed'),
                'reserve': [(6, 0, [ref('hotel_room_demo_dormitory_bed_2')])],
            })]"
        />
    </record>
    <!-- Dormitory bed 3 is taken today. -->
    <record id="hotel_reservation_demo_dormitory_bed_3" model="hotel.reservation">
        <field
            name="date_order"
            eval="(datetime.now() + timedelta(days=-1)).strftime('%Y-%m-%d 08:00:00')"
