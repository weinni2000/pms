            })]"
        />
    </record>
    <!-- A reservation only books its rooms once confirmed. -->
    <function model="hotel.reservation" name="confirmed_reservation">
        <value
            eval="[
                ref('hotel_reservation_demo_flat_1'),
                ref('hotel_reservation_demo_dormitory_bed_1'),
                ref('hotel_reservation_demo_dormitory_bed_2'),
                ref('hotel_reservation_demo_dormitory_bed_3'),
            ]"
        />
    </function>
</odoo>
