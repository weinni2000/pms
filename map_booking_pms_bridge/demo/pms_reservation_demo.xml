            name="start"
            eval="(datetime.now() + timedelta(days=-1)).strftime('%Y-%m-%d 15:00:00')"
        />
        <field
            name="stop"
            eval="(datetime.now() + timedelta(days=2)).strftime('%Y-%m-%d 10:00:00')"
        />
        <field name="partner_id" ref="pms_sale.demo_guest_bob" />
        <field name="stage_id" ref="pms_sale.pms_stage_confirmed" />
    </record>
    <!-- Dormitory bed 3 is taken today. -->
    <record id="pms_reservation_demo_dormitory_bed_3" model="pms.reservation">
        <field name="property_id" ref="pms_property_demo_dormitory_bed_3" />
